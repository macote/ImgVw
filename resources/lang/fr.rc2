/////////////////////////////////////////////////////////////////////////////
// French (Canada) resources

#if !defined(AFX_RESOURCE_DLL) || defined(AFX_TARG_FRC)
LANGUAGE LANG_FRENCH, SUBLANG_FRENCH_CANADIAN
#pragma code_page(1252)

/////////////////////////////////////////////////////////////////////////////
//
// Menu
//

IMGPOPUP MENU
BEGIN
    POPUP "Root"
    BEGIN
        MENUITEM "Ouvrir une image...\tCtrl+O", IDM_OPEN_IMAGE
        MENUITEM "Ouvrir un dossier...\tCtrl+Maj+O", IDM_OPEN_FOLDER
        MENUITEM SEPARATOR
        MENUITEM "Image suivante\tFlèche droite | Molette vers le bas", IDR_NEXT
        MENUITEM "Image précédente\tFlèche gauche | Molette vers le haut", IDR_PREVIOUS
        MENUITEM "Première image\tDébut", IDR_FIRST
        MENUITEM "Dernière image\tFin", IDR_LAST
        MENUITEM SEPARATOR
        MENUITEM "Afficher ou masquer le nom du fichier\tEspace", IDR_TOGGLE_FILENAME
        MENUITEM "Mettre à la corbeille\tSuppr", IDR_RECYCLE
        MENUITEM SEPARATOR
        MENUITEM "Activer ou désactiver le diaporama\tF3", IDR_TOGGLESS
        MENUITEM "Activer ou désactiver le diaporama aléatoire\tF4", IDR_TOGGLESSR
        MENUITEM "Activer ou désactiver le diaporama multiécran\tF5", IDR_TOGGLESS_MULTI
        MENUITEM "Activer ou désactiver le diaporama aléatoire multiécran\tF6", IDR_TOGGLESS_MULTI_RANDOM
        MENUITEM "Augmenter la vitesse du diaporama\tF7", IDR_INCSSS
        MENUITEM "Diminuer la vitesse du diaporama\tF8", IDR_DECSSS
        MENUITEM SEPARATOR
        MENUITEM "Ajouter les fichiers des sous-dossiers\tF9", IDR_RECURSE
        MENUITEM SEPARATOR
        MENUITEM "Sélectionner le profil ICC CMJN par défaut...\tF11", IDM_LOADICC
        MENUITEM "Utiliser le profil ICC CMJN intégré\tF12", IDM_USEBUILTINICC
        MENUITEM SEPARATOR
        POPUP "&Langue"
        BEGIN
            MENUITEM "&Système", IDM_LANGUAGE_SYSTEM
            MENUITEM "&English", IDM_LANGUAGE_ENGLISH
            MENUITEM "&Français", IDM_LANGUAGE_FRENCH
        END
        MENUITEM SEPARATOR
        MENUITEM "&À propos...\tF1", IDM_ABOUT
        MENUITEM SEPARATOR
        MENUITEM "&Quitter\tÉchap", IDM_EXIT
    END
END

/////////////////////////////////////////////////////////////////////////////
//
// Dialog
//

IDD_ABOUTBOX DIALOGEX 100, 75, 145, 62
STYLE DS_SETFONT | DS_MODALFRAME | DS_FIXEDSYS | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "À propos d'ImgVw"
FONT 8, "MS Shell Dlg", 0, 0, 0x1
BEGIN
    ICON            IDI_ICON, IDC_STATIC, 14, 14, 21, 20
    LTEXT           "ImgVw v1.12.4", IDC_STATIC, 42, 14, 114, 8, SS_NOPREFIX
    LTEXT           "", IDC_STATIC, 42, 26, 114, 8
    DEFPUSHBUTTON   "OK", IDOK, 70, 41, 50, 14, WS_GROUP
END

