//
// String Table
//

STRINGTABLE
BEGIN
    IDS_APP_TITLE                  "ImgVw"
    IDC_IMGVW                      "IMGVW"
    IDS_APP_ERROR_TITLE            "Erreur d'ImgVw"
    IDS_ERROR_TEMP_DIR             "ImgVw n'a pas pu initialiser son dossier temporaire d'images (erreur 0x{0})."
    IDS_EMPTY_BEGIN                "Ouvrez une image ou parcourez un dossier pour commencer."
    IDS_EMPTY_PATH_OPEN_FAILED     "Impossible d'ouvrir le fichier ou le dossier sélectionné."
    IDS_EMPTY_PICKER_OPEN_FAILED   "Impossible d'afficher la fenêtre de sélection de fichiers ou de dossiers."
    IDS_DROP_SINGLE_ONLY           "Déposez une seule image ou un seul dossier à la fois."
    IDS_EMPTY_NO_IMAGES            "Aucune image prise en charge n'a été trouvée dans ce dossier."
    IDS_EMPTY_NO_IMAGES_SUBFOLDERS "Aucune image prise en charge n'a été trouvée dans ce dossier ou ses sous-dossiers."
    IDS_EMPTY_SEARCHING_SUBFOLDERS "Recherche d'images prises en charge dans les sous-dossiers..."
    IDS_EMPTY_DRAG_HINT            "Vous pouvez aussi faire glisser une image ou un dossier ici."
    IDS_BTN_OPEN_IMAGE             "Ouvrir une &image..."
    IDS_BTN_OPEN_FOLDER            "Ouvrir un &dossier..."
    IDS_BTN_SEARCH_SUBFOLDERS      "&Rechercher dans les sous-dossiers"
    IDS_BTN_EXIT                   "&Quitter"
    IDS_PICKER_SUPPORTED_IMAGES    "Images prises en charge"
    IDS_PICKER_ALL_FILES           "Tous les fichiers"
    IDS_PICKER_OPEN_IMAGE_TITLE    "Ouvrir une image"
    IDS_PICKER_OPEN_FOLDER_TITLE   "Ouvrir un dossier"
    IDS_ICC_PICKER_TITLE           "Sélectionner le profil ICC CMJN par défaut..."
    IDS_ICC_FILTER_PROFILE         "Profil ICC"
    IDS_ICC_FILTER_ALL             "Tous les fichiers"
    IDS_CMYK_ERROR_TITLE           "Erreur de profil CMJN"
    IDS_CMYK_REMOVE_FAILED         "Impossible de supprimer le profil ICC CMJN enregistré."
    IDS_CMYK_INVALID_TITLE         "Profil ICC CMJN invalide"
    IDS_CMYK_INVALID_FILE          "Le fichier sélectionné n'est pas un profil ICC CMJN valide."
    IDS_CMYK_STORE_FAILED          "Impossible d'enregistrer le profil ICC CMJN sélectionné."
    IDS_LANGUAGE_SAVE_FAILED       "La préférence de langue n'a pas pu être enregistrée. Le choix s'appliquera uniquement à cette session."
    IDS_STATS_SUMMARY              "Images trouvées : {0}; en cache : {1}; en attente : {2}; places libres : {3}/{4}"
    IDS_STATS_FREE_SUFFIX          "; mémoire libre : {0}"
    IDS_STATS_SLIDESHOW_LINE       "Mode : {0}; cycle : {1}/{2}"
    IDS_STATS_SLIDESHOW_PERCENT_SUFFIX " ({0})"
    IDS_STATS_MODE_RANDOM          "diaporama aléatoire"
    IDS_STATS_MODE_SEQUENTIAL      "diaporama séquentiel"
    IDS_STATS_COL_SIZE             "Dimensions"
    IDS_STATS_COL_READY            "Prêtes"
    IDS_STATS_COL_LOADED           "Chargées"
    IDS_STATS_COL_LOADING          "Chargement"
    IDS_STATS_COL_QUEUED           "En attente"
    IDS_STATS_COL_ERRORS           "Erreurs"
    IDS_STATS_COL_USED             "Mémoire"
END

#endif // French (Canada) resources
